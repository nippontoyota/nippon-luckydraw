# Database (Postgres — Supabase for prod, local Postgres for dev)
# App: Transaction pooler (6543) — NOT db.xxx:6543. Copy from Supabase → Connect → ORMs → Prisma.
# Migrations: Direct (5432) via DIRECT_URL.
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=15"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres"

# Admin Auth
SESSION_SECRET="generate-a-random-64-char-hex-string"
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_EMAIL="admin@nippontoyota.com"

# DoubleTick (WhatsApp)
DOUBLETICK_API_KEY="dbt-xxx"
DOUBLETICK_API_URL="https://api.doubletick.io/v1"
DOUBLETICK_WEBHOOK_SECRET="whsec_xxx"

# Upstash (Rate Limiting)
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="generate-a-random-string"

# Supabase (future — RLS, storage, real-time)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
